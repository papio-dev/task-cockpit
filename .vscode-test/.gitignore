# Игнорировать всё в этом каталоге
*
# ...кроме самого этого файла
!.gitignore


!package.json
!color.mjs
!test-runner.mjs
!mocha.cjs
!host-anchor.cjs
!interactive-runner.mjs



!user-data/
!user-data/User/
!user-data/User/settings.json
!user-data/User/keybindings.json

!user-data/User/profiles/
!user-data/User/profiles/*

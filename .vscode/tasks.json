                "showReuseMessage": false,
                "group": "Debug"
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1,
                "instancePolicy": "warn"
            }
        },
        {
            "label": "Build (debug)|Create/Clean `~out-debug/`",
            "detail": "",
            "icon": {
                "id": "new-folder"
            },
            "type": "shell",
            "command": [
                "set -euo pipefail ; ",
                "[[ -d \"${OUT_DIR}\" && \"$(basename \"${OUT_DIR}\")\" == ~* ]] || { echo \"OUT_DIR='${OUT_DIR}' — not a directory or its name does not start with '~'\" ; exit 1 ; }; ",
                "find \"${OUT_DIR}\" -mindepth 1 -maxdepth 1 -exec gio trash -- {} + ; "
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "OUT_DIR": "~out-debug"
                }
            },
            "presentation": {
                "panel": "shared",
                "clear": false,
                "showReuseMessage": false,
                "group": "Debug"
            },
            "problemMatcher": []
        },
        {
            "label": "Build (debug)|Transpile TypeScript to `./~out-debug`",
            "detail": "",
            "icon": {
                "id": "target"
            },
            "type": "shell",
            "command": [
                "set -euo pipefail ; ",
                "npx tsc -p \"${TSCONFIG}\" --outDir \"${OUT_DIR}\" ; "
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "TSCONFIG": "debug.tsconfig.json",
                    "OUT_DIR": "~out-debug"
                }
            },
            "presentation": {
                "panel": "shared",
                "clear": false,
                "showReuseMessage": false,
                "group": "Debug"
            },
            "problemMatcher": {
                "applyTo": "allDocuments",
                "base": "$tsc"
            }
        },

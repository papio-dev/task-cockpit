            "label": "Build (debug)|Copy icons to `./~out-debug`",
            "detail": "Copy icons to distribution",
            "icon": {
                "id": "copy"
            },
            "type": "shell",
            "command": [
                "set -euo pipefail ; ",
                "IFS=':' read -ra files <<< \"${FILES}\" ; ",
                "mkdir -p \"${OUT_DIR}\" ; ",
                "cp \"${files[@]}\" \"${OUT_DIR}/\" ; "
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "OUT_DIR": "./~out-debug",
                    "FILES": "./icons/panel-icon.svg"

            "type": "shell",
            "dependsOrder": "sequence",
            "command": [
                "set -euo pipefail ; ",
                "if pids=$(pgrep -f \".vscode-test/.*/code .*--extensionDevelopmentPath=${workspaceFolder}/${OUT_DIR}/${EXT_SANDBOX}\" 2> /dev/null); then",
                "kill $pids 2> /dev/null || true;",
                "for pid in $pids;",
                "do",
                "while kill -0 \"$pid\" 2> /dev/null; do",
                "sleep 0.2;",
                "done;",
                "done;",
                "fi;",
                "[[ -d \"./${OUT_DIR}\" && \"$(basename \"${OUT_DIR}\")\" == ~* ]] || {",
                "echo \"OUT_DIR='${OUT_DIR}' — not a directory or its name does not start with '~'\";",
                "exit 1 ; }; ",
                "find \"./${OUT_DIR}\" -mindepth 1 -maxdepth 1 -exec gio trash -- {} +;",
                "npx tsc -p ./${EXT_SANDBOX}/tsconfig.json && setsid -f ./.vscode-test/interactive-runner.mjs && sleep 3"

{
  "name": "task-cockpit",
  "publisher": "papio-dev",
  "displayName": "Task Cockpit test extension",
  "description": "Task Cockpit test extension",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "extension.js",
  "contributes": {
    "commands": [
      {
        "title": "-DEBUG- print state",
        "command": "_debug.printState"
      },
      {
        "title": "-DEBUG- force full refresh",
        "command": "_debug.forceFullRefresh"
      },
      {
        "title": "-DEBUG- recreate",
        "command": "_debug.recreate"
      }
    ]
  }
}
